# ==============================================================================
# Prestiq Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Secrets (NEVER commit credentials, tokens, or local env files)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
*.der
*.p12
*.pkcs12
*.jks
*.keystore
credentials.json
client_secret*.json
service-account*.json
secrets/

# ------------------------------------------------------------------------------
# macOS & Windows System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ------------------------------------------------------------------------------
# Java & Maven Build Artifacts (root and all submodules)
# ------------------------------------------------------------------------------
**/target/
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
.mvn/timing.properties
.flattened-pom.xml

# ------------------------------------------------------------------------------
# Database Dumps & Local Storage
# ------------------------------------------------------------------------------
*.dump
*.sql.gz
*.sql.dump
*.backup
*.sqlite
*.sqlite3
*.db

# ------------------------------------------------------------------------------
# Python Virtual Environments & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# IDEs & Text Editors
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.vscode/
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
bin/

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.swp
*~
