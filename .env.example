# ==============================================================================
# Prestiq — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Populate placeholders with your actual development or cloud credentials.
# 3. NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Native PostgreSQL Configuration (Common Infrastructure)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database Names (9 Independently Owned Databases)
AUTH_DB_NAME=prestiq_auth_db
STUDENT_DB_NAME=prestiq_student_db
SCHOLARSHIP_DB_NAME=prestiq_scholarship_db
ELIGIBILITY_DB_NAME=prestiq_eligibility_db
RECOMMENDATION_DB_NAME=prestiq_recommendation_db
APPLICATION_DB_NAME=prestiq_application_db
NOTIFICATION_DB_NAME=prestiq_notification_db
AI_DB_NAME=prestiq_ai_db
INGESTION_DB_NAME=prestiq_ingestion_db

# JDBC Connection URLs for Java Services (Spring Data JPA / Flyway)
AUTH_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${AUTH_DB_NAME}
STUDENT_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${STUDENT_DB_NAME}
SCHOLARSHIP_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${SCHOLARSHIP_DB_NAME}
ELIGIBILITY_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${ELIGIBILITY_DB_NAME}
RECOMMENDATION_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${RECOMMENDATION_DB_NAME}
APPLICATION_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${APPLICATION_DB_NAME}
NOTIFICATION_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${NOTIFICATION_DB_NAME}

# Asyncpg Connection URLs for Python Services (FastAPI / SQLAlchemy / pgvector)
AI_DB_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${AI_DB_NAME}
INGESTION_DB_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${INGESTION_DB_NAME}

# ------------------------------------------------------------------------------
# 2. Service Ports & Ingress Gateway
# ------------------------------------------------------------------------------
API_GATEWAY_PORT=8080
DISCOVERY_SERVER_PORT=8761
AUTH_SERVICE_PORT=8081
STUDENT_SERVICE_PORT=8082
SCHOLARSHIP_SERVICE_PORT=8083
ELIGIBILITY_SERVICE_PORT=8084
RECOMMENDATION_SERVICE_PORT=8085
APPLICATION_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
AI_SERVICE_PORT=8000
INGESTION_SERVICE_PORT=8001

# Service URLs for Gateway & Inter-Service REST Routing
DISCOVERY_SERVER_URL=http://localhost:${DISCOVERY_SERVER_PORT}/eureka
AUTH_SERVICE_URL=http://localhost:${AUTH_SERVICE_PORT}
STUDENT_SERVICE_URL=http://localhost:${STUDENT_SERVICE_PORT}
SCHOLARSHIP_SERVICE_URL=http://localhost:${SCHOLARSHIP_SERVICE_PORT}
ELIGIBILITY_SERVICE_URL=http://localhost:${ELIGIBILITY_SERVICE_PORT}
RECOMMENDATION_SERVICE_URL=http://localhost:${RECOMMENDATION_SERVICE_PORT}
APPLICATION_SERVICE_URL=http://localhost:${APPLICATION_SERVICE_PORT}
NOTIFICATION_SERVICE_URL=http://localhost:${NOTIFICATION_SERVICE_PORT}
AI_SERVICE_URL=http://localhost:${AI_SERVICE_PORT}
INGESTION_SERVICE_URL=http://localhost:${INGESTION_SERVICE_PORT}

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Tokens
# ------------------------------------------------------------------------------
# JWT Access Token Configuration (Minimum 256-bit random hex/base64 string)
JWT_SECRET=your-256-bit-jwt-secret-placeholder-min-32-characters-change-in-production
JWT_ISSUER=prestiq-auth
JWT_EXPIRATION_SECONDS=900
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Inter-Service Mutual Authentication Secret / Key
INTERNAL_SERVICE_KEY=your-internal-service-key-placeholder-min-32-characters

# ------------------------------------------------------------------------------
# 4. Multi-Provider AI & Embedding Configuration
# Note: Verified free-tier models. Never allow automatic fallback to paid models.
# ------------------------------------------------------------------------------
# Global AI Provider Strategy (Task Routing)
PRIMARY_AI_PROVIDER=gemini
FALLBACK_AI_PROVIDER=groq
TERTIARY_AI_PROVIDER=cerebras
EMERGENCY_AI_PROVIDER=openrouter
ALLOW_PAID_FALLBACK=false

# Google Gemini API (AI Studio Free Tier: 15 RPM, 1M TPM, 1,500 RPD)
# Provides both text generation and free embeddings.
GEMINI_API_KEY=your-gemini-api-key-placeholder
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_RPM_LIMIT=15

# Groq API (Inference Only: 30 RPM, 1k RPD for 70B, 14.4k RPD for 8B)
# Used for sub-200ms prompt-injection checks and secondary RAG fallback.
GROQ_API_KEY=your-groq-api-key-placeholder
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_RPM_LIMIT=30

# Cerebras API (Inference Only: 30 RPM, 60k TPM, 1M tokens/day)
# Tertiary generation fallback.
CEREBRAS_API_KEY=your-cerebras-api-key-placeholder
CEREBRAS_MODEL=llama-3.1-70b
CEREBRAS_RPM_LIMIT=30

# OpenRouter API (Quota Buffer on :free models: 20 RPM, 50 RPD)
OPENROUTER_API_KEY=your-openrouter-api-key-placeholder
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_RPM_LIMIT=20

# Vector Storage & Retrieval Parameters
EMBEDDING_DIMENSIONS=768
RAG_MIN_SIMILARITY=0.55
RAG_MAX_CHUNKS=5

# ------------------------------------------------------------------------------
# 5. Low-Memory Local Development Tuning (MacBook Air M2, 8 GB RAM)
# Export this in your shell before running Maven commands:
# export MAVEN_OPTS="-Xms64m -Xmx256m -XX:+TieredCompilation -XX:TieredStopAtLevel=1"
# ------------------------------------------------------------------------------
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:+TieredCompilation -XX:TieredStopAtLevel=1
