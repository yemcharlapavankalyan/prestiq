# ==============================================================================
# PrestIQ Scholarship Ingestion Service Environment Configuration Template
# ==============================================================================

SERVICE_NAME=scholarship-ingestion-service
PORT=8001
ENV=development
DEBUG=false

# Persistence (SQLite for testing / PostgreSQL for production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/prestiq_ingestion_db

# Inter-Service Integration
SCHOLARSHIP_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8000
INTERNAL_SERVICE_KEY=prestiq-internal-dev-secret-key-2026

# JWT Security
JWT_SECRET=your-256-bit-jwt-secret-placeholder-min-32-characters-change-in-production
JWT_ISSUER=prestiq-auth
JWT_ALGORITHM=HS256

# Polite Crawler Limits
USER_AGENT=PrestiqScholarshipBot/1.0 (+https://prestiq.org/bot)
MAX_RESPONSE_BYTES=5242880
CONNECT_TIMEOUT_SECONDS=5.0
READ_TIMEOUT_SECONDS=15.0
MAX_RETRIES=3
RATE_LIMIT_DEFAULT_RPM=15

# LLM-Assisted Extraction
LLM_EXTRACTION_ENABLED=true
LLM_PROVIDER=mock
GEMINI_API_KEY=your-gemini-api-key-placeholder
GROQ_API_KEY=your-groq-api-key-placeholder
CEREBRAS_API_KEY=your-cerebras-api-key-placeholder

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_CHECK_INTERVAL_SECONDS=60
